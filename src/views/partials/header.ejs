<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CampusExchange | Student Marketplace</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            neutral: {
              850: '#141414',
              900: '#0f0f0f',
              950: '#050505',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-neutral-950 text-neutral-100 min-h-screen flex flex-col font-sans antialiased selection:bg-white selection:text-black">
  <header class="border-b border-neutral-800 bg-neutral-950 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 bg-white text-black font-black flex items-center justify-center rounded">CX</div>
        <span class="text-white font-bold tracking-tight text-lg">CampusExchange</span>
      </a>
      <nav class="flex items-center gap-4">
  <a href="/listings" class="text-neutral-400 hover:text-white text-sm font-medium transition">Explore</a>
  <% if (user) { %>
    <a href="/dashboard" class="text-neutral-400 hover:text-white text-sm font-medium transition">Dashboard</a>
    <a href="/profile" class="text-neutral-400 hover:text-white text-sm font-medium transition">Profile</a>
    <a href="/listings/new" class="bg-white text-black hover:bg-neutral-200 px-3.5 py-1.5 rounded text-sm font-semibold transition">Post Item</a>
    <a href="/logout" class="text-xs border border-neutral-800 px-2.5 py-1 rounded text-neutral-400 hover:text-white transition">Sign Out</a>
  <% } else { %>
    <a href="/login" class="text-neutral-400 hover:text-white text-sm font-medium transition">Sign In</a>
    <a href="/register" class="bg-white text-black hover:bg-neutral-200 px-3.5 py-1.5 rounded text-sm font-semibold transition">Register</a>
  <% } %>
</nav>
    </div>
  </header>
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8">