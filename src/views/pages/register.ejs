<%- include('../partials/header') %>

<div class="max-w-md mx-auto py-8">
  <div class="border border-neutral-800 bg-neutral-900/60 p-8 rounded-xl shadow-lg">
    <h2 class="text-2xl font-bold text-white mb-2">Create an account</h2>
    <p class="text-neutral-400 text-sm mb-6">Trade items with peers at your college</p>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/30 text-red-400 p-3 rounded text-sm mb-4">
        <%= error %>
      </div>
    <% } %>

    <form action="/register" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-neutral-400 mb-1">Full Name</label>
        <input type="text" name="name" required class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
      </div>
      <div>
        <label class="block text-xs font-medium text-neutral-400 mb-1">Campus Email</label>
        <input type="email" name="email" required class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-neutral-400 mb-1">College</label>
          <input type="text" name="college" required class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-neutral-400 mb-1">Department</label>
          <input type="text" name="department" placeholder="e.g. BCA, CS" class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-neutral-400 mb-1">Year</label>
          <input type="text" name="year" placeholder="e.g. 2nd Year" class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-neutral-400 mb-1">Phone / WhatsApp</label>
          <input type="text" name="phone" placeholder="Optional" class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-neutral-400 mb-1">Password</label>
        <input type="password" name="password" required class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
      </div>
      <button type="submit" class="w-full bg-white text-black py-2 rounded font-semibold text-sm hover:bg-neutral-200 transition">Register</button>
    </form>

    <div class="mt-6 text-center text-xs text-neutral-500">
      Already have an account? <a href="/login" class="text-white hover:underline">Sign in</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>