<%- include('../partials/header') %>

<div class="max-w-4xl mx-auto py-6">
  <a href="/listings" class="text-xs text-neutral-500 hover:text-white mb-6 inline-block">&larr; Back to all listings</a>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="border border-neutral-800 bg-neutral-900 rounded-xl overflow-hidden h-80 flex items-center justify-center">
      <% if (listing.image_url) { %>
        <img src="<%= listing.image_url %>" alt="<%= listing.title %>" class="w-full h-full object-cover">
      <% } else { %>
        <span class="text-neutral-600 text-sm">No photo available</span>
      <% } %>
    </div>

    <div class="space-y-6">
      <div>
        <span class="border border-neutral-800 px-2 py-0.5 rounded font-mono text-xs text-neutral-400">
          <%= listing.listing_type %>
        </span>
        <h1 class="text-2xl font-bold text-white mt-2"><%= listing.title %></h1>
        <p class="text-2xl font-black text-white mt-1">
          <% if (listing.listing_type === 'SELL') { %>
            ₹<%= listing.price %>
          <% } else if (listing.listing_type === 'GIVEAWAY') { %>
            <span class="text-emerald-400">FREE</span>
          <% } else { %>
            <span class="text-neutral-300">Exchange: <%= listing.exchange_for %></span>
          <% } %>
        </p>
      </div>

      <div class="border-t border-b border-neutral-800 py-4 space-y-2 text-xs">
        <div class="flex justify-between"><span class="text-neutral-500">Condition</span><span class="text-white"><%= listing.condition %></span></div>
        <div class="flex justify-between"><span class="text-neutral-500">Location</span><span class="text-white"><%= listing.location %></span></div>
        <div class="flex justify-between"><span class="text-neutral-500">College</span><span class="text-white"><%= listing.seller_college %></span></div>
      </div>

      <div>
        <h3 class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-2">Description</h3>
        <p class="text-sm text-neutral-300 leading-relaxed"><%= listing.description %></p>
      </div>

      <!-- Seller Contact Info -->
      <div class="border border-neutral-800 bg-neutral-900/40 p-4 rounded-lg">
        <h4 class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Seller</h4>
        <p class="text-sm font-semibold text-white"><%= listing.seller_name %> (<%= listing.seller_dept || 'Student' %>)</p>
        <% if (listing.seller_phone) { %>
          <a href="https://wa.me/<%= listing.seller_phone %>" target="_blank" class="mt-3 inline-block w-full text-center bg-white text-black py-2 rounded text-xs font-bold hover:bg-neutral-200 transition">
            Contact on WhatsApp
          </a>
        <% } else { %>
          <p class="text-xs text-neutral-500 mt-2">No phone provided. Coordinate in person.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>