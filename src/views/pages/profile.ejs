<%- include('../partials/header') %>

<div class="max-w-lg mx-auto py-8">
  <div class="border border-neutral-800 bg-neutral-900/60 p-8 rounded-xl shadow-lg">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold text-white">Profile Settings</h2>
        <p class="text-xs text-neutral-400">Update your student information and contact details</p>
      </div>
      <a href="/dashboard" class="text-xs text-neutral-400 hover:text-white">&larr; Back to Dashboard</a>
    </div>

    <% if (message) { %>
      <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 p-3 rounded text-xs mb-4">
        <%= message %>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/30 text-red-400 p-3 rounded text-xs mb-4">
        <%= error %>
      </div>
    <% } %>

    <form action="/profile" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-neutral-400 mb-1">Full Name</label>
        <input type="text" name="name" value="<%= profile.name %>" required class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
      </div>

      <div>
        <label class="block text-xs font-medium text-neutral-400 mb-1">Email ID (Cannot be changed)</label>
        <input type="email" value="<%= profile.email %>" disabled class="w-full bg-neutral-900 border border-neutral-800 rounded px-3 py-2 text-sm text-neutral-500 cursor-not-allowed">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-neutral-400 mb-1">College</label>
          <input type="text" name="college" value="<%= profile.college %>" required class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-neutral-400 mb-1">Department</label>
          <input type="text" name="department" value="<%= profile.department || '' %>" placeholder="e.g. BCA, BTech" class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-neutral-400 mb-1">Year of Study</label>
          <input type="text" name="year" value="<%= profile.year || '' %>" placeholder="e.g. 2nd Year, 4th Sem" class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-neutral-400 mb-1">WhatsApp Number</label>
          <input type="text" name="phone" value="<%= profile.phone || '' %>" placeholder="e.g. 919876543210" class="w-full bg-neutral-950 border border-neutral-800 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-500">
          <p class="text-[10px] text-neutral-500 mt-1">Include country code without + (e.g. 91 for India)</p>
        </div>
      </div>

      <button type="submit" class="w-full bg-white text-black py-2 rounded font-semibold text-sm hover:bg-neutral-200 transition">Save Changes</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>